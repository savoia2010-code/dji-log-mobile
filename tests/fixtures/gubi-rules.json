{
 "rules": [
  {
   "id": "airport_150m",
   "clause": "5-1",
   "heading": "空港等周辺・緊急用務空域・地表又は水面から150m以上の高さの空域における飛行",
   "requirements": [
    {
     "id": "airport_150m-1",
     "standard": "機体について、航空機からの視認をできるだけ容易にするため、灯火を装備すること又は飛行時に機体を認識しやすい塗色を行うこと。",
     "alternatives": []
    }
   ]
  },
  {
   "id": "did",
   "clause": "5-2",
   "heading": "人又は家屋の密集している地域の上空における飛行",
   "requirements": [
    {
     "id": "did-1",
     "standard": "機体について、第三者及び物件に接触した際の危害を軽減する機能を有すること。",
     "alternatives": [
      "プロペラガード等を装備していないが、飛行の際は飛行経路全体を見渡せる位置に補助者を配置し、第三者が飛行範囲内に立ち入らないよう注意喚起を行う。",
      "プロペラガードを装備している。装備しない場合は、飛行の際は飛行経路全体を見渡せる位置に補助者を配置し、第三者が飛行範囲内に立ち入らないよう注意喚起を行う。"
     ]
    }
   ]
  },
  {
   "id": "night",
   "clause": "5-3",
   "heading": "夜間飛行",
   "requirements": [
    {
     "id": "night-1",
     "standard": "機体について、無人航空機の姿勢及び方向が正確に視認できるよう灯火を有していること。ただし、無人航空機の飛行範囲が照明等で十分照らされている場合は、この限りでない。",
     "alternatives": [
      "飛行範囲が照明等で十分に照らされており、機体の姿勢及び方向の視認が可能な状態で飛行する。"
     ]
    }
   ]
  },
  {
   "id": "bvlos",
   "clause": "5-4",
   "heading": "目視外飛行",
   "requirements": [
    {
     "id": "bvlos-1",
     "standard": "自動操縦システムを装備し、機体に設置されたカメラ等により機体の外の様子を監視できること。",
     "alternatives": []
    },
    {
     "id": "bvlos-2",
     "standard": "地上において、無人航空機の位置及び異常の有無を把握できること（不具合発生時に不時着した場合を含む。）。",
     "alternatives": []
    },
    {
     "id": "bvlos-3",
     "standard": "不具合発生時に危機回避機能（フェールセーフ機能）が正常に作動すること。",
     "alternatives": []
    }
   ]
  },
  {
   "id": "distance30",
   "clause": "5-5",
   "heading": "地上又は水上の人又は物件との間に30mの距離を保てない飛行",
   "requirements": [
    {
     "id": "distance30-1",
     "standard": "機体について、第三者及び物件に接触した際の危害を軽減する機能を有すること。",
     "alternatives": [
      "プロペラガード等を装備していないが、飛行の際は飛行経路全体を見渡せる位置に補助者を配置し、第三者が飛行範囲内に立ち入らないよう注意喚起を行う。",
      "プロペラガードを装備している。装備しない場合は、飛行の際は飛行経路全体を見渡せる位置に補助者を配置し、第三者が飛行範囲内に立ち入らないよう注意喚起を行う。"
     ]
    }
   ]
  },
  {
   "id": "event",
   "clause": "5-6",
   "heading": "多数の者の集合する催し場所の上空における飛行",
   "requirements": [
    {
     "id": "event-1",
     "standard": "第三者及び物件に接触した際の危害を軽減する機能を有すること。",
     "alternatives": []
    },
    {
     "id": "event-2",
     "standard": "想定される運用により、10回以上の離陸及び着陸を含む3時間以上の飛行実績を有すること。",
     "alternatives": []
    }
   ]
  },
  {
   "id": "hazardous",
   "clause": "5-7",
   "heading": "危険物の輸送",
   "requirements": [
    {
     "id": "hazardous-1",
     "standard": "機体について、危険物の輸送に適した装備が備えられていること。",
     "alternatives": []
    }
   ]
  },
  {
   "id": "drop",
